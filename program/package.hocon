// The program: a musicbox score played through miniaudio, with SDL3 drawing the one button.
//
// **The `name` here is not what the application is called.** It is the sysl package's own name and
// nothing reads it — the two names that matter are in `gradle.properties`, one directory up.
package {
  name    = "program"
  version = "0.1.3"

  // skitter 0.3.0's floor: `logcat` needs sysl 0.0.161.
  sysl = "0.0.161"
}

// **Three coordinates.** Skitter brings SDL3 with it, and musicbox-miniaudio brings miniaudio.
// musicbox is named on its own because this program imports it for `parse`; one build carries one
// version of a package, the newest any manifest names.
dependencies {
  skitter            { git = "github.com/sysl-lang/skitter", version = "0.3.3" }
  musicbox         { git = "github.com/sysl-lang/musicbox", version = "0.1.4" }
  musicbox-miniaudio { git = "github.com/sysl-lang/musicbox-miniaudio", version = "0.1.1" }
}

// What SDL3 and miniaudio require, restated because a program reaching a gated module has to say so
// too. Android answers both: Bionic is POSIX, and `Os.Android` is in the compiler's POSIX set.
requires {
  heap  = true
  posix = true
}
